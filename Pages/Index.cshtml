@page
@model PowerDNS_Web.Pages.IndexModel
@using System.Text.Json
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = L["Title"];
    // пакуем строки для JS (безопасно экранируется JSON'ом)
    var i18n = new
    {
        NoData = L["Common.NoData"].Value,
        Loading = L["Common.Loading"].Value,
        ChartQpsLabel = L["Chart.Dataset.Qps"].Value,
        TimeH = L["Time.H"].Value,
        TimeM = L["Time.M"].Value
    };
}

<div class="container mt-3">

    <!-- ========================= PAGE HEADER ========================= -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div>
            <h2 class="mb-0"><i class="fa fa-chart-line me-2"></i>@L["OverviewTitle"].Value</h2>
            <div class="text-muted small">@L["OverviewSubtitle"].Value</div>
        </div>
        <div class="d-flex align-items-center gap-2">
        </div>
    </div>

    <!-- ========================= PRIMARY METRICS ========================= -->
    <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-4">
        <div class="col">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-label">@L["Metric.ActivePort"].Value</div>
                    <div class="stat-value" id="activePort">--</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-label">@L["Metric.Uptime"].Value</div>
                    <div class="stat-value" id="uptime">--</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-label">@L["Metric.TotalQueries"].Value</div>
                    <div class="stat-value" id="totalQueries">--</div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card stat-card h-100">
                <div class="card-body">
                    <div class="stat-label">@L["Metric.QpsApprox"].Value</div>
                    <div class="stat-value" id="qps">--</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================= DETAIL LISTS ========================= -->
    <h5 class="mt-4 mb-2 text-center">@L["Section.Statistics"].Value</h5>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header text-center bg-body-secondary">
                    <h6 class="mb-0 text-warning-emphasis"><i class="fa fa-exclamation-triangle me-1"></i>@L["Card.MissingTypes"].Value</h6>
                </div>
                <div class="card-body">
                    <pre id="noerror-queries" class="log-container">@L["Common.Loading"].Value</pre>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header text-center bg-body-secondary">
                    <h6 class="mb-0 text-danger-emphasis"><i class="fa fa-exclamation-circle me-1"></i>@L["Card.Nonexistent"].Value</h6>
                </div>
                <div class="card-body">
                    <pre id="nxdomain-queries" class="log-container">@L["Common.Loading"].Value</pre>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-header text-center bg-body-secondary">
                    <h6 class="mb-0 text-success-emphasis"><i class="fa fa-check-circle me-1"></i>@L["Card.UdpReceived"].Value</h6>
                </div>
                <div class="card-body">
                    <pre id="queries" class="log-container">@L["Common.Loading"].Value</pre>
                </div>
            </div>
        </div>
    </div>

    @if (ViewData["RecursorEnabled"]?.ToString() == "Enabled")
    {
        <!-- ========================= RECURSOR METRICS ========================= -->
        <h5 class="mt-5 mb-2 text-center"><i class="fa fa-database me-2"></i>@L["Recursor.Title"].Value</h5>

        <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-4">
            <div class="col">
                <div class="card stat-card h-100">
                    <div class="card-body">
                        <div class="stat-label">@L["Recursor.Port"].Value</div>
                        <div class="stat-value">53</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card stat-card h-100">
                    <div class="card-body">
                        <div class="stat-label">@L["Recursor.Uptime"].Value</div>
                        <div class="stat-value" id="recursorUptime">--</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card stat-card h-100">
                    <div class="card-body">
                        <div class="stat-label">@L["Recursor.CacheHits"].Value</div>
                        <div class="stat-value" id="recursorCacheHits">--</div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card stat-card h-100">
                    <div class="card-body">
                        <div class="stat-label">@L["Recursor.CacheMissesRatio"].Value</div>
                        <div class="stat-value">
                            <span id="recursorCacheMisses">--</span>
                            <span class="mx-2 text-muted">·</span>
                            <span id="recursorHitRatio">--</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================= RECURSOR LISTS ========================= -->
        <div class="row g-3 mt-1">
            <div class="col-12 col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header text-center bg-body-secondary">
                        <h6 class="mb-0">@L["Recursor.TopRequests"].Value</h6>
                    </div>
                    <div class="card-body">
                        <pre id="top-queries" class="log-container">@L["Common.Loading"].Value</pre>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header text-center bg-body-secondary">
                        <h6 class="mb-0"><i class="fa fa-network-wired me-1"></i>@L["Recursor.TopRemotes"].Value</h6>
                    </div>
                    <div class="card-body">
                        <pre id="top-remotes" class="log-container">@L["Common.Loading"].Value</pre>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ========================= CHART: QPS LAST 5 MIN ========================= -->
    <div class="mt-5">
        <h6 class="text-muted mb-2">@L["Chart.QpsLast5m"].Value</h6>
        <canvas id="queryChart"></canvas>
    </div>
</div>

@Html.AntiForgeryToken()

<!-- CHART.JS (YOUR LOCAL BUNDLE) -->
<script src="~/js/chart.js"></script>

@section Scripts {
    <script>
        // i18n strings from server
        const I18N = @Html.Raw(JsonSerializer.Serialize(i18n));

        const recursorEnabled = @Html.Raw(JsonSerializer.Serialize(ViewData["RecursorEnabled"]?.ToString() ?? ""));
    </script>
    <script src="~/js/pages/dashboard.js" asp-append-version="true"></script>
}
